  "regex_rules": [
    {
      "id": "weekday_short",
      "stage": "weekday",
      "role": "weekday",
      "pattern": "(?<!\\w)(?:t|thứ\\s*)([2-7])(?!\\w)",
      "replace": "thứ \\1",
      "examples": [ { "in": "họp t6", "out": "họp thứ 6" }, { "in": "thứ6 9h", "out": "thứ 6 9h" } ]
    },
    {
      "id": "weekday_this",
      "stage": "weekday",
      "role": "weekday",
      "pattern": "(?<!\\w)(thứ [2-7]|chủ nhật)\\s+này(?!\\w)",
      "replace": "\\1 tuần này",
      "examples": [ { "in": "thứ 6 này", "out": "thứ 6 tuần này" } ]
    },
    {
      "id": "weekday_upcoming",
      "stage": "weekday",
      "role": "weekday",
      "note": "'thứ 6 tới' = thứ 6 gần nhất sắp tới; parse_time() tự chọn lần gần nhất trong tương lai khi không có 'tuần này/sau'.",
      "pattern": "(?<!\\w)(thứ [2-7]|chủ nhật)\\s+(?:sắp tới|tới|toi)(?!\\w)(?!\\s*nữa)",
      "replace": "\\1",
      "examples": [ { "in": "thứ 6 tới", "out": "thứ 6" } ]
    },
    {
      "id": "weekday_week_after_next",
      "stage": "weekday",
      "role": "date",
      "pattern": "(?<!\\w)(thứ [2-7]|chủ nhật)\\s+tuần\\s+sau\\s+nữa(?!\\w)",
      "compute": { "type": "week_day", "weekday_group": 1, "week_offset": 2 },
      "examples": [ { "in": "thứ 6 tuần sau nữa", "out": "ngày 04/12/2026" } ]
    },
    {
      "id": "weekday_every",
      "stage": "weekday",
      "role": "weekday+repeat",
      "pattern": "(?<!\\w)(?:vào mỗi|vào các|mỗi|mọi|các)\\s+((?:sáng|trưa|chiều|tối|đêm)\\s+)?(thứ [2-7]|chủ nhật)(?!\\w)",
      "replace": "\\1\\2 hàng tuần",
      "examples": [ { "in": "mỗi thứ 2", "out": "thứ 2 hàng tuần" }, { "in": "các chủ nhật", "out": "chủ nhật hàng tuần" }, { "in": "mỗi sáng thứ 2", "out": "sáng thứ 2 hàng tuần" } ]
    },

    {
      "id": "number_word_before_unit",
      "stage": "number_words",
      "role": "pre",
      "note": "Với ngày/tuần/tháng/năm chỉ đổi khi theo sau là 'nữa/sau/tới/một lần' để không làm hỏng câu kiểu 'một ngày đẹp trời'.",
      "pattern": "(?<!\\w)(mười một|mười hai|mười lăm|mười|hai mươi lăm|hai mươi|hai lăm|ba mươi|bốn mươi lăm|bốn lăm|một|hai|ba|bốn|năm|sáu|bảy|bẩy|tám|chín)(?=\\s+(?:(?:phút|phut|tiếng|tieng|giờ|gio|rưỡi|ruoi)(?!\\w)|(?:ngày|ngay|tuần|tuan|tháng|thang|năm|nam)\\s+(?:nữa|nua|sau|tới|toi|một lần|1 lần)(?!\\w)))",
      "compute": { "type": "number_word", "group": 1 },
      "examples": [ { "in": "hai tiếng nữa", "out": "2 tiếng nữa" }, { "in": "ba giờ chiều", "out": "3 giờ chiều" }, { "in": "mười lăm phút nữa", "out": "15 phút nữa" } ]
    },
    {
      "id": "number_word_after_kem",
      "stage": "number_words",
      "role": "pre",
      "pattern": "(?<!\\w)(kém|kem)\\s+(mười lăm|mười|năm|hai mươi lăm|hai mươi|hai lăm)(?!\\w)",
      "compute": { "type": "number_word", "group": 2, "output": "kém {n}" },
      "examples": [ { "in": "8 giờ kém mười lăm", "out": "8 giờ kém 15" } ]
    },

    {
      "id": "rel_hours_half",
      "stage": "relative",
      "role": "relative",
      "pattern": "(?<!\\w)(\\d{1,2})\\s*(?:tiếng|tieng|giờ|gio|h)\\s*(?:rưỡi|ruoi)\\s+(?:nữa|nua|sau)(?!\\w)",
      "compute": { "type": "relative_minutes", "hours_group": 1, "half": true },
      "examples": [ { "in": "1 tiếng rưỡi nữa", "out": "90 phút nữa" } ]
    },
    {
      "id": "rel_hours_minutes",
      "stage": "relative",
      "role": "relative",
      "pattern": "(?<!\\w)(\\d{1,2})\\s*(?:tiếng|tieng|giờ|gio|h)\\s*(\\d{1,2})\\s*(?:phút|phut|ph|p)?\\s+(?:nữa|nua|sau)(?!\\w)",
      "compute": { "type": "relative_minutes", "hours_group": 1, "minutes_group": 2 },
      "examples": [ { "in": "1 tiếng 15 phút nữa", "out": "75 phút nữa" } ]
    },
    {
      "id": "rel_minutes",
      "stage": "relative",
      "role": "relative",
      "pattern": "(?<!\\w)(\\d{1,4})\\s*(?:phút|phut|ph|p|')\\s*(?:nữa|nua|sau|tới|toi)(?!\\w)",
      "replace": "\\1 phút nữa",
      "examples": [ { "in": "15p nữa", "out": "15 phút nữa" }, { "in": "20 phut nua", "out": "20 phút nữa" } ]
    },
    {
      "id": "rel_hours",
      "stage": "relative",
      "role": "relative",
      "note": "'2 giờ sau' thường là 'sau 2 tiếng'. Nếu muốn coi là 2h chiều thì bỏ 'sau' khỏi pattern.",
      "pattern": "(?<!\\w)(?<!thứ )(\\d{1,2})\\s*(?:tiếng|tieng|giờ|gio|h)\\s*(?:nữa|nua|sau)(?!\\w)",
      "replace": "\\1 giờ nữa",
      "examples": [ { "in": "2 tiếng nữa", "out": "2 giờ nữa" }, { "in": "3h nua", "out": "3 giờ nữa" } ]
    },
    {
      "id": "rel_days",
      "stage": "relative",
      "role": "date",
      "pattern": "(?<!\\w)(?<!thứ )(?<!ngày )(?<!ngay )(?<!mùng )(?<!mồng )(?<!mung )(?<!mong )(\\d{1,3})\\s*(?:ngày|ngay)\\s*(?:nữa|nua|sau|tới|toi)(?!\\w)",
      "compute": { "type": "relative_days", "days_group": 1 },
      "examples": [ { "in": "3 ngày nữa", "out": "ngày 21/11/2026" } ]
    },
    {
      "id": "rel_weeks",
      "stage": "relative",
      "role": "date",
      "note": "Lookbehind loại 'thứ 6 tuần sau', 'ngày 5 tháng sau' (số ở đó là thứ/ngày, không phải số lượng).",
      "pattern": "(?<!\\w)(?<!thứ )(?<!ngày )(?<!ngay )(?<!mùng )(?<!mồng )(?<!mung )(?<!mong )(\\d{1,2})\\s*(?:tuần|tuan)\\s*(?:nữa|nua|sau|tới|toi)(?!\\w)",
      "compute": { "type": "relative_weeks", "group": 1 },
      "examples": [ { "in": "2 tuần nữa", "out": "ngày 02/12/2026" } ]
    },
    {
      "id": "rel_months",
      "stage": "relative",
      "role": "date",
      "pattern": "(?<!\\w)(?<!thứ )(?<!ngày )(?<!ngay )(?<!mùng )(?<!mồng )(?<!mung )(?<!mong )(\\d{1,2})\\s*(?:tháng|thang)\\s*(?:nữa|nua|sau|tới|toi)(?!\\w)",
      "compute": { "type": "relative_months", "group": 1 },
      "examples": [ { "in": "1 tháng nữa", "out": "ngày 18/12/2026" } ]
    },
    {
      "id": "rel_years",
      "stage": "relative",
      "role": "date",
      "pattern": "(?<!\\w)(?<!thứ )(?<!ngày )(?<!ngay )(?<!mùng )(?<!mồng )(?<!mung )(?<!mong )(?<!tháng )(\\d{1,2})\\s*(?:năm|nam)\\s*(?:nữa|nua|sau|tới|toi)(?!\\w)",
      "compute": { "type": "relative_years", "group": 1 },
      "examples": [ { "in": "1 năm nữa", "out": "ngày 18/11/2027" } ]
    },
    {
      "id": "rel_english",
      "stage": "relative",
      "role": "relative",
      "pattern": "(?<!\\w)in\\s+(\\d{1,3})\\s*(minutes?|mins?|hours?|hrs?|days?|weeks?)(?!\\w)",
      "compute": { "type": "relative_en", "number_group": 1, "unit_group": 2 },
      "examples": [ { "in": "in 10 minutes", "out": "10 phút nữa" } ]
    },

    {
      "id": "date_iso",
      "stage": "date",
      "role": "date",
      "pattern": "(?<![\\d/])(\\d{4})[-/.](\\d{1,2})[-/.](\\d{1,2})(?![\\d/])",
      "replace": "ngày \\3/\\2/\\1",
      "examples": [ { "in": "2026-12-05", "out": "ngày 05/12/2026" } ]
    },
    {
      "id": "date_text_full",
      "stage": "date",
      "role": "date",
      "pattern": "(?<!\\w)(?:(?:ngày|ngay|mùng|mồng|mung|mong)\\s+)?(\\d{1,2})\\s+tháng\\s+(\\d{1,2})\\s*(?:năm|,|/)?\\s*(\\d{4})(?!\\d)",
      "replace": "ngày \\1/\\2/\\3",
      "examples": [ { "in": "ngày 5 tháng 12 năm 2026", "out": "ngày 5/12/2026" }, { "in": "20 tháng 11 2026", "out": "ngày 20/11/2026" } ]
    },
    {
      "id": "date_dmy",
      "stage": "date",
      "role": "date",
      "pattern": "(?<![\\d/.:])(?:(?:ngày|ngay)\\s+)?(\\d{1,2})[-/.](\\d{1,2})[-/.](\\d{4})(?![\\d/.])",
      "replace": "ngày \\1/\\2/\\3",
      "examples": [ { "in": "20-11-2026", "out": "ngày 20/11/2026" }, { "in": "ngày 05.12.2026", "out": "ngày 05/12/2026" } ]
    },
    {
      "id": "date_dmy_short_year",
      "stage": "date",
      "role": "date",
      "pattern": "(?<![\\d/.:])(?:(?:ngày|ngay)\\s+)?(\\d{1,2})[-/.](\\d{1,2})[-/.](\\d{2})(?![\\d/.])",
      "replace": "ngày \\1/\\2/20\\3",
      "examples": [ { "in": "20/11/26", "out": "ngày 20/11/2026" } ]
    },
    {
      "id": "date_text_no_year",
      "stage": "date",
      "role": "date",
      "pattern": "(?<!\\w)(?:ngày|ngay|mùng|mồng|mung|mong)\\s+(\\d{1,2})\\s+tháng\\s+(\\d{1,2})(?!\\d)(?!\\s*(?:âm\\s*lịch|âm|năm|/)(?!\\w))",
      "compute": { "type": "infer_year", "day_group": 1, "month_group": 2 },
      "examples": [ { "in": "ngày 5 tháng 12", "out": "ngày 05/12/2026" }, { "in": "mùng 2 tháng 9", "out": "ngày 02/09/2027" } ]
    },
    {
      "id": "date_day_of_relative_month",
      "stage": "date",
      "role": "date",
      "pattern": "(?<!\\w)(?:ngày|ngay|mùng|mồng|mung|mong)\\s+(\\d{1,2})\\s+(tháng sau nữa|tháng này|tháng sau)(?!\\w)",
      "compute": { "type": "day_of_month", "day_group": 1, "offset_group": 2 },
      "examples": [ { "in": "ngày 5 tháng sau", "out": "ngày 05/12/2026" }, { "in": "ngày 25 tháng này", "out": "ngày 25/11/2026" } ]
    },
    {
      "id": "date_month_start",
      "stage": "date",
      "role": "date",
      "pattern": "(?<!\\w)đầu\\s+tháng\\s+(\\d{1,2})(?:\\s*(?:/|năm)\\s*(\\d{4}))?(?![\\d/])",
      "compute": { "type": "month_day", "day": 1, "month_group": 1, "year_group": 2 },
      "examples": [ { "in": "đầu tháng 12", "out": "ngày 01/12/2026" }, { "in": "đầu tháng 3/2027", "out": "ngày 01/03/2027" } ]
    },
    {
      "id": "date_month_mid",
      "stage": "date",
      "role": "date",
      "pattern": "(?<!\\w)giữa\\s+tháng\\s+(\\d{1,2})(?:\\s*(?:/|năm)\\s*(\\d{4}))?(?![\\d/])",
      "compute": { "type": "month_day", "day": 15, "month_group": 1, "year_group": 2 },
      "examples": [ { "in": "giữa tháng 1", "out": "ngày 15/01/2027" } ]
    },
    {
      "id": "date_month_end",
      "stage": "date",
      "role": "date",
      "pattern": "(?<!\\w)cuối\\s+tháng\\s+(\\d{1,2})(?:\\s*(?:/|năm)\\s*(\\d{4}))?(?![\\d/])",
      "compute": { "type": "month_day", "day": "last", "month_group": 1, "year_group": 2 },
      "examples": [ { "in": "cuối tháng 2/2027", "out": "ngày 28/02/2027" } ]
    },
    {
      "id": "date_month_year_only",
      "stage": "date",
      "role": "date",
      "note": "Chỉ nói tháng/năm, không nói ngày: mặc định ngày 01 (giống quy tắc 'đầu tháng' trong prompt LLM).",
      "pattern": "(?<!\\w)tháng\\s+(\\d{1,2})\\s*(?:/|năm)\\s*(\\d{4})(?![\\d/])",
      "compute": { "type": "month_day", "day": 1, "month_group": 1, "year_group": 2 },
      "examples": [ { "in": "tháng 12/2026", "out": "ngày 01/12/2026" } ]
    },
    {
      "id": "date_dd_mm_infer_year",
      "stage": "date",
      "role": "date",
      "note": "Ngày dạng DD/MM không có năm. Không áp dụng nếu theo sau là 'âm lịch'.",
      "pattern": "(?<![\\d/.:])(?:(?:ngày|ngay)\\s+)?(\\d{1,2})/(\\d{1,2})(?![\\d/])(?!\\s*(?:âm\\s*lịch|âm)(?!\\w))",
      "compute": { "type": "infer_year", "day_group": 1, "month_group": 2 },
      "examples": [ { "in": "20/11", "out": "ngày 20/11/2026" }, { "in": "ngày 10/11", "out": "ngày 10/11/2027" } ]
    },
    {
      "id": "date_day_only",
      "stage": "date",
      "role": "date",
      "note": "Chỉ có ngày ('mùng 5', 'ngày 20'): lấy lần gần nhất sắp tới.",
      "pattern": "(?<!\\w)(?<!hàng )(?<!hằng )(?<!mỗi )(?<!hang )(?<!moi )(?:ngày|ngay|mùng|mồng|mung|mong)\\s+(\\d{1,2})(?![\\d/:.])(?!\\s*(?:tháng|thang|âm\\s*lịch|âm|nữa|nua|sau|tới|toi|lần|lan)(?!\\w))(?!\\s*(?:h|giờ|gio|g|rưỡi|ruoi|kém|kem)(?![a-zà-ỹ]))",
      "compute": { "type": "next_day_of_month", "day_group": 1 },
      "examples": [ { "in": "mùng 5", "out": "ngày 05/12/2026" }, { "in": "ngày 25", "out": "ngày 25/11/2026" } ]
    },

    {
      "id": "duration_h_m",
      "stage": "time",
      "role": "duration",
      "note": "Khoảng thời gian (không phải giờ nhắc): đổi 'h/giờ' thành 'tiếng' để các luật giờ phía sau không bắt nhầm. Phải đứng trước các luật time_*. 'còn 2h nữa' đã được stage relative xử lý trước nên không bị ảnh hưởng.",
      "pattern": "(?<!\\w)(còn|con|mất|mat|tốn|ton|trong vòng|kéo dài|thời lượng|tối đa|tối thiểu)\\s+(?:khoảng\\s+|tầm\\s+|chừng\\s+|gần\\s+|hơn\\s+)?(\\d{1,2})\\s*(?:h|giờ|gio|tiếng|tieng)\\s*(\\d{1,2})\\s*(?:phút|phut|ph|p)?(?!\\w)(?!\\s*(?:nữa|nua|sau|tới|toi)(?!\\w))",
      "replace": "\\1 \\2 tiếng \\3 phút",
      "examples": [ { "in": "mất 1h30", "out": "mất 1 tiếng 30 phút" }, { "in": "còn 2 giờ 15 phút", "out": "còn 2 tiếng 15 phút" } ]
    },
    {
      "id": "duration_h",
      "stage": "time",
      "role": "duration",
      "pattern": "(?<!\\w)(còn|con|mất|mat|tốn|ton|trong vòng|kéo dài|thời lượng|tối đa|tối thiểu)\\s+(?:khoảng\\s+|tầm\\s+|chừng\\s+|gần\\s+|hơn\\s+)?(\\d{1,2})\\s*(?:h|giờ|gio|tiếng|tieng)(?!\\w)(?!\\s*(?:rưỡi|ruoi|nữa|nua|sau|tới|toi|\\d)(?!\\w))",
      "replace": "\\1 \\2 tiếng",
      "examples": [ { "in": "còn 2h", "out": "còn 2 tiếng" }, { "in": "kéo dài khoảng 3 giờ", "out": "kéo dài 3 tiếng" }, { "in": "trong vòng 1h", "out": "trong vòng 1 tiếng" } ]
    },
    {
      "id": "duration_h_half",
      "stage": "time",
      "role": "duration",
      "pattern": "(?<!\\w)(còn|con|mất|mat|tốn|ton|trong vòng|kéo dài|thời lượng|tối đa|tối thiểu)\\s+(?:khoảng\\s+|tầm\\s+|chừng\\s+|gần\\s+|hơn\\s+)?(\\d{1,2})\\s*(?:h|giờ|gio|tiếng|tieng)\\s*(?:rưỡi|ruoi)(?!\\w)(?!\\s*(?:nữa|nua|sau|tới|toi)(?!\\w))",
      "replace": "\\1 \\2 tiếng rưỡi",
      "examples": [ { "in": "mất 1 tiếng rưỡi", "out": "mất 1 tiếng rưỡi" }, { "in": "còn 2h rưỡi", "out": "còn 2 tiếng rưỡi" } ]
    },
    {
      "id": "time_kem",
      "stage": "time",
      "role": "time",
      "pattern": "(?<![\\w:])([01]?\\d|2[0-3])\\s*(?:h|giờ|gio|g)\\s*(?:kém|kem)\\s*([0-5]?\\d)(?:\\s*(?:phút|phut|ph|p))?(?!\\w)",
      "compute": { "type": "time_minus", "hour_group": 1, "minute_group": 2 },
      "examples": [ { "in": "8h kém 15", "out": "07:45" }, { "in": "10 giờ kém 10 phút", "out": "09:50" } ]
    },
    {
      "id": "time_half",
      "stage": "time",
      "role": "time",
      "pattern": "(?<![\\w:])([01]?\\d|2[0-3])\\s*(?:h|giờ|gio|g)?\\s*(?:rưỡi|ruoi)(?!\\w)",
      "replace": "\\1:30",
      "examples": [ { "in": "4 rưỡi chiều", "out": "4:30 chiều" }, { "in": "8h rưỡi", "out": "8:30" } ]
    },
    {
      "id": "time_h_m",
      "stage": "time",
      "role": "time",
      "pattern": "(?<![\\w:])([01]?\\d|2[0-3])\\s*(?:h|giờ|gio|g)\\s*([0-5]?\\d)(?:\\s*(?:phút|phut|ph|p|'))?(?![\\d/])(?!\\s*(?:nữa|nua|sau|ngày|ngay|tuần|tuan|tháng|thang|năm|nam|người|nguoi)(?!\\w))",
      "replace": "\\1:\\2",
      "examples": [ { "in": "8h30", "out": "8:30" }, { "in": "14 giờ 15 phút", "out": "14:15" }, { "in": "9g45", "out": "9:45" }, { "in": "8 giờ 30 sáng", "out": "8:30 sáng" } ]
    },
    {
      "id": "time_h_only",
      "stage": "time",
      "role": "time",
      "note": "Không nhận 'g' đứng riêng ('3g', '4g' thường là mạng di động); '9g30' vẫn được rule time_h_m xử lý.",
      "pattern": "(?<![\\w:])([01]?\\d|2[0-3])\\s*(?:giờ|gio|h)(?:\\s*(?:đúng|dung))?(?![\\w:])(?!\\s*(?:nữa|nua|sau|tới|toi)(?!\\w))",
      "replace": "\\1:00",
      "examples": [ { "in": "9h sáng", "out": "9:00 sáng" }, { "in": "3 giờ đúng", "out": "3:00" }, { "in": "15h", "out": "15:00" } ]
    },
    {
      "id": "time_dot",
      "stage": "time",
      "role": "time",
      "note": "'14.00' / '9.30'. Chạy sau stage 'date' nên '12.05.2026' đã thành ngày. '12.05' đứng riêng được hiểu là giờ, giống parse_message_timefirst hiện tại.",
      "pattern": "(?<![\\d/.:])([01]?\\d|2[0-3])\\.([0-5]\\d)(?![\\d/.])",
      "replace": "\\1:\\2",
      "examples": [ { "in": "14.00 họp", "out": "14:00 họp" } ]
    },
    {
      "id": "time_ampm",
      "stage": "time",
      "role": "time",
      "pattern": "(?<![\\w:])(1[0-2]|0?[1-9])(?::([0-5]\\d))?\\s*(a\\.?m\\.?|p\\.?m\\.?)(?!\\w)",
      "compute": { "type": "ampm", "hour_group": 1, "minute_group": 2, "marker_group": 3 },
      "examples": [ { "in": "9pm", "out": "21:00" }, { "in": "7:30 am", "out": "07:30" } ]
    },
    {
      "id": "time_colon_pad",
      "stage": "time",
      "role": "time",
      "note": "Chuẩn hoá cuối cùng: 9:5 -> 9:05 (parser vẫn hiểu cả hai, rule này chỉ để đẹp).",
      "pattern": "(?<![\\d:])([01]?\\d|2[0-3]):(\\d)(?![\\d])",
      "replace": "\\1:0\\2",
      "examples": [ { "in": "9:5", "out": "9:05" } ]
    },

    {
      "id": "repeat_n_unit_per_time",
      "stage": "repeat",
      "role": "repeat",
      "pattern": "(?<!\\w)(?:cứ\\s+)?(\\d{1,3})\\s*(ngày|tuần|tháng|năm)\\s*(?:một|1)\\s*lần(?!\\w)",
      "replace": "mỗi \\1 \\2",
      "examples": [ { "in": "3 ngày 1 lần", "out": "mỗi 3 ngày" }, { "in": "2 tuần một lần", "out": "mỗi 2 tuần" }, { "in": "cứ 2 tháng 1 lần", "out": "mỗi 2 tháng" } ]
    },
    {
      "id": "repeat_cu_n_unit",
      "stage": "repeat",
      "role": "repeat",
      "pattern": "(?<!\\w)cứ\\s+(\\d{1,3})\\s*(ngày|tuần|tháng|năm)(?:\\s*(?:một|1)\\s*lần)?(?!\\w)",
      "replace": "mỗi \\1 \\2",
      "examples": [ { "in": "cứ 2 tuần", "out": "mỗi 2 tuần" } ]
    },
    {
      "id": "repeat_strip_lap_lai",
      "stage": "repeat",
      "role": "repeat",
