    "compute_types": {
      "number_word": "Đổi số bằng chữ (group) sang chữ số theo bảng 'number_words'. Nếu có 'output' thì format theo đó với {n}.",
      "relative_minutes": "Tổng số phút = hours*60 + minutes (+30 nếu half=true). Trả về '{N} phút nữa'.",
      "relative_days": "now + N ngày (N lấy từ 'days' hoặc group 'days_group'). Trả về 'ngày DD/MM/YYYY'.",
      "relative_weeks": "now + 7*N ngày. Trả về 'ngày DD/MM/YYYY'.",
