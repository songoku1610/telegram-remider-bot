      "relative_en": "Tiếng Anh 'in N minutes/hours/days/weeks': minutes/hours -> '{N} phút nữa' / '{N} giờ nữa'; days/weeks -> 'ngày DD/MM/YYYY'.",
      "infer_year": "Ngày DD/MM không có năm: nếu DD/MM năm nay >= hôm nay thì dùng năm nay, ngược lại dùng năm sau. Bỏ qua nếu ngày/tháng không hợp lệ. Trả về 'ngày DD/MM/YYYY'.",
      "next_day_of_month": "Chỉ có ngày (mùng 5, ngày 20): tháng này nếu ngày đó >= hôm nay, ngược lại tháng sau. Nếu tháng không có ngày đó (31/11) thì bỏ qua. Trả về 'ngày DD/MM/YYYY'.",
      "day_of_month": "Ngày D của tháng (hiện tại + month_offset). month_offset lấy từ bảng 'offset_words' theo group. Trả về 'ngày DD/MM/YYYY'.",
      "month_day": "Ngày 'day' (số, hoặc 'last' = ngày cuối tháng) của tháng chỉ định. Nếu có month_group/year_group thì dùng tháng/năm đó (không có năm thì áp quy tắc infer_year). Nếu không có tháng thì dùng tháng hiện tại + month_offset; roll_forward=true nghĩa là kết quả đã qua thì đẩy sang tháng sau. Trả về 'ngày DD/MM/YYYY'.",
      "week_day": "Thứ 'weekday' (0=T2 … 6=CN) của tuần (tuần hiện tại + week_offset), tuần bắt đầu thứ 2 (giống get_weekday()). Có thể lấy weekday từ group 'weekday_group' ('thứ N' -> N-2, 'chủ nhật' -> 6). roll_forward=true: đã qua thì cộng 7 ngày. Trả về 'ngày DD/MM/YYYY'.",
      "year_day": "Ngày day/month của năm (hiện tại + year_offset). roll_forward=true: đã qua thì sang năm sau. Trả về 'ngày DD/MM/YYYY'.",
      "time_minus": "'H giờ kém M' = (H-1):(60-M). Trả về 'HH:MM'.",
      "ampm": "am: 12 -> 0, giữ nguyên các giờ khác; pm: +12 nếu giờ < 12. Trả về 'HH:MM'.",
      "same_time": "Cùng giờ phút với hiện tại, cộng thêm 'days' ngày. Trả về 'HH:MM ngày DD/MM/YYYY'.",
      "lunar_new_year_eve": "Ngày cuối của tháng 12 âm lịch (29 hoặc 30, tính bằng lunarcalendar). Trả về 'ngày DD/12 âm lịch'."
    },
    "examples_now": "Kết quả của các ví dụ compute được tính với now = 2026-11-18 09:00 (Thứ 4)."
